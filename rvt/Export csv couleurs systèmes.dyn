    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "0de0b205f35042d9812a11ed7dd679aa",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "f369005669ee4abbbd7c83e41967c2cd",
          "Name": "lists",
          "Description": "Liste de listes à transposer\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "5a6eb8967ebd4b958a961b08e4999813",
          "Name": "lists",
          "Description": "Liste des listes transposées",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.Transpose@var[]..[]",
      "Replication": "Auto",
      "Description": "Permute des lignes et des colonnes dans une liste des listes. Si certaines lignes sont plus courtes que d'autres, les valeurs nulles sont insérées en tant qu'espaces réservés dans le réseau obtenu de sorte qu'il est toujours rectangulaire.\n\nList.Transpose (lists: var[]..[]): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Charger les bibliothèques DesignScript et Standard Python\r\nimport sys\r\nimport clr\r\n\r\nclr.AddReference(\"DSCoreNodes\")\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference('ProtoGeometry')\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.DesignScript.Geometry import *\r\nfrom DSCore import Color as DSColor\r\n\r\n# Les entrées effectuées dans ce noeud sont stockées sous forme de liste dans les variables IN.\r\ndataEnteringNode = IN\r\nsystem_types = IN[0]\r\n\r\n# Placer votre code au-dessous de cette ligne\r\nresult = []\r\n\r\nfor st in system_types:\r\n    # Récupérer l'objet Revit natif\r\n    try:\r\n        sys_type = st.InternalElement\r\n    except:\r\n        sys_type = st\r\n\r\n    # Récupérer la couleur définie dans les remplacements de graphisme\r\n    try:\r\n        color = sys_type.LineColor\r\n        result.append(DSColor.ByARGB(255, color.Red, color.Green, color.Blue))\r\n\r\n    except:\r\n        result.append(None)\r\n\r\n# Affectez la sortie à la variable OUT.\r\nOUT = result",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "97d2b3658b4b4300813fbb2a780219b6",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "9c7086f6a9e84693bb4323c29c886c55",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "7bfaecfa40ee4b78bca4422ff787eb5a",
          "Name": "OUT",
          "Description": "Résultat du script Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Exécute un script Python intégré."
    },
