    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Charger les bibliothèques DesignScript et Standard Python\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Les entrées effectuées dans ce noeud sont stockées sous forme de liste dans les variables IN.\r\ndataEnteringNode = IN\r\nsystem_types = IN[0]\r\n\r\n# Placer votre code au-dessous de cette ligne\r\nresult = []\r\n\r\nfor st in system_types:\r\n    # Récupérer l'objet Revit natif\r\n    try:\r\n        sys_type = st.InternalElement\r\n    except:\r\n        sys_type = st\r\n\r\n    # Récupérer la couleur définie dans les remplacements de graphisme\r\n    try:\r\n        color = sys_type.LineColor\r\n        result.append((color.Red, color.Green, color.Blue))\r\n    except:\r\n        result.append(None)\r\n\r\n# Affectez la sortie à la variable OUT.\r\nOUT = result",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "89f17f859d98462cae5f9495ea03b360",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "20848e291926431ba10677985e134b4f",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "c3cdf2b57c4f4b7d933baf2f68b66249",
          "Name": "OUT",
          "Description": "Résultat du script Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Exécute un script Python intégré."
    },
    {
      "ConcreteType": "CoreNodeModels.CreateList, CoreNodeModels",
      "VariableInputPorts": true,
